# Server environment (EXAMPLE) — copy to a private .env or export in your shell.
# Do NOT commit real secrets. .env/.env.* are gitignored.

# Strong secret for admin CLI/API (X-Admin-Token)
ADMIN_TOKEN=change-me-to-a-long-random-secret

# SQLite path (keep PRIVATE, back it up). Default: server/licenses.db
# LICENSE_DB_PATH=/secure/path/licenses.db

# Bind address/port (run behind HTTPS reverse proxy in production)
LICENSE_SERVER_HOST=127.0.0.1
LICENSE_SERVER_PORT=8787

# Optional: where daily runner writes private outputs when used standalone
# VIETLOTT_OUT_DIR=/secure/path/out/daily
