# Example Nginx reverse proxy (put inside server{} with TLS configured via certbot/your CA).
# Run license_server bound to 127.0.0.1:8787 behind this proxy.

# upstream/license server
# upstream vietlott_license { server 127.0.0.1:8787; }

location / {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # consider: limit_req / auth / IP allowlists for /api/admin/* at the edge
    proxy_read_timeout 120s;
}
